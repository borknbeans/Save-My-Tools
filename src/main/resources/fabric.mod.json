{
	"schemaVersion": 1,
	"id": "save-my-tools",
	"version": "${version}",
	"name": "Save My Tools",
	"description": "Simple clientside mod that prevents you from accidentally breaking your tools.",
	"authors": [
		"Borknbeans"
	],
	"contact": {
		"sources": "https://github.com/borknbeans/Save-My-Tools"
	},
	"license": "MIT",
	"icon": "assets/save-my-tools/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"borknbeans.savemytools.SaveMyTools"
		],
		"client": [
			"borknbeans.savemytools.SaveMyToolsClient"
		]
	},
	"mixins": [
		"save-my-tools.mixins.json",
		{
			"config": "save-my-tools.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}